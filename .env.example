# Локальные настройки. Скопируй в .env и заполни секреты (файл .env НЕ коммитится).
# Прод-аналог этих ключей — Environment в панели Render (см. docs/DEPLOY.md).

# --- Локальный Postgres (docker-compose) ---
POSTGRES_DB=tourist_tma
POSTGRES_USER=tourist
POSTGRES_PASSWORD=tourist_secret
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Бэкенд ---
# Локально: postgresql+asyncpg://tourist:tourist_secret@localhost:5432/tourist_tma
# Supabase (Render): postgresql+asyncpg://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://tourist:tourist_secret@localhost:5432/tourist_tma
REDIS_URL=redis://localhost:6379/0

# Токен от @BotFather: проверка подписи initData + уведомления админу
TELEGRAM_BOT_TOKEN=
# Числовой Telegram ID супер-админа (узнать: @userinfobot). Сюда приходят черновики.
ADMIN_TELEGRAM_ID=
# URL Mini App (Vercel) для кнопки меню бота и deep-линков ?route=ID
MINI_APP_URL=
# Радиус быстрого чек-ина в метрах (ТЗ §4Б)
CHECKIN_RADIUS_M=300
# Секрет JWT (следующий шаг). На Render генерируется автоматически.
JWT_SECRET=change-me-local
# Лимит свежести auth_date, сек (0 — не проверять, только для тестов)
AUTH_DATE_MAX_AGE=86400
# Dev-вход без подписи Telegram (кнопка «Войти локально»). Только локалка!
# В проде (Render) НЕ задавать — по умолчанию выключено.
DEV_LOGIN_ENABLED=true
# CORS: "*" для тестов; прод: https://tourist-tma.vercel.app
CORS_ORIGINS=*

# --- Фронтенд ---
# Локально: http://localhost:8000 ; прод: https://<backend>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
